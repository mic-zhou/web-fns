{
  "name": "web-fns",
  "version": "0.1.0",
  "description": "Pure JS utility functions for web apps: number/date/currency formatting, validate, storage/cookie, dom helpers. Zero dependencies, framework-agnostic (Vue2/Vue3/React).",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mic-zhou/web-fns.git"
  },
  "homepage": "https://github.com/mic-zhou/web-fns#readme",
  "bugs": {
    "url": "https://github.com/mic-zhou/web-fns/issues"
  },
  "keywords": [
    "utils",
    "format",
    "validate",
    "cookie",
    "storage",
    "dom",
    "zero-dependency"
  ],
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@vitest/coverage-v8": "^0.34.6",
    "jsdom": "^22.0.0",
    "typescript": "^4.9.5",
    "vitest": "^0.34.6"
  }
}
